{
  "name": "mp3-api",
  "version": "1.0.14",
  "description": "mp3-api",
  "main": "main.js",
  "types": "dist",
  "repository": {
    "type": "git",
    "url": "https://github.com/nvhung9/mp3-api"
  },
  "keywords": [
    "zingmp3",
    "mp3-api",
    "zingmp3 api",
    "api"
  ],
  "author": "mrhung9 <mrhung.io.vn>",
  "license": "ISC",
  "scripts": {
    "dev": "nodemon --watch server.js --watch public --ext js,html,css --exec node server.js",
    "start": "node server.js",
    "build:exe": "electron-builder -w"
  },
  "build": {
    "appId": "com.devchill.musicapp",
    "productName": "DevChillMusic",
    "icon": "public/uploads/images/logo/DevChillLogoApp.png",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "license": "license.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevChillMusic",
      "include": "installer.nsh"
    },
    "files": [
      "server.js",
      "main.js",
      "public/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ]
  },
  "devDependencies": {
    "@types/node": "^16.11.11",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.10",
    "typescript": "^4.5.2",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "axios": "^0.24.0",
    "cors": "^2.8.6",
    "express": "^5.1.0"
  }
}